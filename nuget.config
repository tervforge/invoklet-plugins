<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- The Invoklet contract packages. Locally a folder filled by `dotnet pack` in an Invoklet checkout; release builds point this
         source at GitHub Packages (see README.md). -->
    <add key="invoklet" value="artifacts/contracts" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="invoklet">
      <package pattern="Invoklet.Plugins" />
      <package pattern="Invoklet.Contracts" />
      <package pattern="Invoklet.Format.MdRun" />
    </packageSource>
  </packageSourceMapping>
</configuration>
