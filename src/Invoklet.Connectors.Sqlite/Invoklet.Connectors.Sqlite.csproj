<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../PluginPackage.props" />
  <PropertyGroup>
    <RootNamespace>Invoklet.Connectors.Sqlite</RootNamespace>
    <Description>SQLite connections for Invoklet.</Description>
    <PackageTags>$(PackageTags) sqlite efcore database</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Invoklet.Connectors.Tests" />
    <InternalsVisibleTo Include="Invoklet.Connectors.IntegrationTests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The EF Core plugin, which the manifest lists in dependsOn. -->
    <ProjectReference Include="../Invoklet.Connectors.EfCore/Invoklet.Connectors.EfCore.csproj" />
  </ItemGroup>
  <Import Project="../../build/EfCoreDesign.props" />
</Project>
